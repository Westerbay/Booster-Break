{
  "name": "tcg-collection",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "dev": "bun scripts/dev.ts",
    "dev:web": "bun --cwd apps/web dev",
    "dev:api": "bun --cwd apps/api dev",
    "build": "bun --filter '*' build",
    "build:web": "bun --cwd apps/web build",
    "build:api": "bun --cwd apps/api build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "bun --filter '*' lint",
    "test": "bun --filter '*' test",
    "typecheck": "bun --filter '*' typecheck",
    "test:dependency-security": "node --test scripts/security/*.test.cjs"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "deepmerge": "4.3.1",
    "zod-v3": "npm:zod@3.25.76"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "@hono/node-server": "2.1.3",
    "hono": "4.13.14",
    "js-yaml": "4.3.2",
    "vite": "8.3.5",
    "postcss-selector-parser": "7.1.6",
    "seroval@^1": "1.6.12",
    "@modelcontextprotocol/sdk@^1": "1.32.2",
    "baseline-browser-mapping@^2": "2.11.34",
    "body-parser@^2": "2.4.0",
    "brace-expansion@^5": "5.0.12",
    "browserslist@^4": "4.29.5",
    "deepmerge-ts@^7": "8.0.2",
    "fast-uri@^3": "3.1.9",
    "ip-address@^10": "10.7.5",
    "mysql2@^3": "3.24.6",
    "nanoid@^3": "3.3.20",
    "postcss@^8": "8.5.32",
    "proxy-addr@^2": "2.0.8",
    "qs@^6": "6.16.1",
    "source-map-js@^1": "1.2.2",
    "valibot@^1": "1.5.0",
    "zod@^4": "4.6.7"
  },
  "patchedDependencies": {
    "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch",
    "zod@3.25.76": "patches/zod@3.25.76.patch",
    "minimatch@10.2.5": "patches/minimatch@10.2.5.patch"
  }
}
